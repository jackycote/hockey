# Local development only. Generate .env with: pnpm setup:env
API_HOST=127.0.0.1
API_PORT=3000
POSTGRES_USER=hockey
POSTGRES_DB=hockey_iq
POSTGRES_PASSWORD=
DATABASE_URL=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hockey-iq-private
MINIO_ROOT_USER=hockey-local
MINIO_ROOT_PASSWORD=
# OIDC is required in production; synthetic demo sign-in is development only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Legacy SESSION_SECRET is unused: sessions use random opaque tokens stored hashed.

# Hockey Doo v1.2: embedded PostgreSQL for local development; postgres in production.
API_DB_MODE=embedded
API_DATA_DIR=.data
ENABLE_DEMO_AUTH=false
PUBLIC_APP_URL=http://127.0.0.1:5174
BLOB_BACKEND=local
PROPOSED_SEASON_PRICE_CAD=49

# Dedicated object-storage credentials are preferred in production.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 64 hex characters (32 random bytes), stored outside the repository and backup destination.
BACKUP_KEY=

# Optional per-instance request limits; defaults are 180 API / 30 auth in production.
# API_RATE_LIMIT=180
# AUTH_RATE_LIMIT=30
